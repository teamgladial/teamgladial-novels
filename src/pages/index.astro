---
const bookFiles = import.meta.glob('../content/books/*.md', { eager: true });
const books = Object.values(bookFiles).map((entry) => (entry as any).frontmatter).filter((book) => !book.draft).sort((a, b) => String(b.date).localeCompare(String(a.date)));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/gladial-mark.png" />
    <link rel="stylesheet" href="/theme.css" />
    <script is:inline>(() => { const saved = localStorage.getItem('gladial-theme'); document.documentElement.dataset.theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'); window.addEventListener('DOMContentLoaded', () => { const button = document.querySelector('[data-theme-toggle]'); if (!button) return; const sync = () => { const dark = document.documentElement.dataset.theme === 'dark'; button.textContent = dark ? '☀' : '☾'; button.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode'); }; sync(); button.addEventListener('click', () => { const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'; document.documentElement.dataset.theme = next; localStorage.setItem('gladial-theme', next); sync(); }); }); })();</script>
    <meta name="description" content="Fiction, novels, and stories published under the Gladial imprint." />
    <meta name="theme-color" content="#f1eee8" />
    <title>Fiction | Gladial</title>
  </head>
  <body class="theme-novels">
    <main>
      <header><a href="https://gladial.com" class="brand"><img src="/gladial-mark.png" alt="Gladial logo" /> GLADIAL <span>BOOKS</span></a><a href="https://gladial.com" class="back">← Gladial home</a><button class="theme-toggle" data-theme-toggle aria-label="Switch color mode">☾</button></header>
      <section class="hero"><p class="eyebrow">STORIES FOR THE IN-BETWEEN</p><h1>Worlds to<br /><i>step into.</i></h1><p class="intro">Fiction made for lingering: novels, short stories, and the occasional strange place to get lost for a while.</p></section>
      <section class="shelf" aria-labelledby="shelf-title"><div class="shelf-title"><h2 id="shelf-title">On the shelf</h2><span>FICTION &amp; LONG-FORM STORIES</span></div>
        {books.length ? <div class="books">{books.map((book) => <article class="book">{book.coverImage ? <img class="book-cover-image" src={book.coverImage} alt={book.imageAlt || `Cover for ${book.title}`} loading="lazy" /> : <div class="cover"><span>{book.title}</span><small>{book.author}</small></div>}<div><p class="genre">{book.category || book.genre}</p><h3>{book.title}</h3><p>{book.description}</p>{book.url && <a href={book.url}>Read more ↗</a>}</div></article>)}</div> : <div class="empty"><div class="book-mark"><span>G</span></div><div><h3>The first story is taking shape.</h3><p>New fiction and long-form stories will be collected here. Check back when the pages are ready to turn.</p></div></div>}
      </section>
      <footer><span>Stories published independently by Gladial.</span><a href="https://gladial.com">GLADIAL ↗</a></footer>
    </main>
  </body>
</html>
<style>
  :global(*){box-sizing:border-box}:global(body){margin:0;background:#f1eee8;color:#282621;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}main{width:min(900px,calc(100% - 48px));margin:auto}a{color:inherit;text-decoration:none}header{height:80px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #dfd9ce}.brand{font-size:11px;font-weight:800;letter-spacing:.16em}.brand span{margin-left:9px;color:#988f81;font-weight:500}.back{color:#756f63;font-size:13px}.hero{padding:clamp(88px,14vw,150px) 0 105px}.eyebrow,.shelf-title>span,.genre{color:#8c806d;font-size:10px;font-weight:700;letter-spacing:.16em}.hero h1{margin:28px 0 22px;font-family:Georgia,"Times New Roman",serif;font-size:clamp(58px,10vw,102px);font-weight:400;line-height:.94;letter-spacing:-.06em}.hero h1 i{color:#876d58;font-weight:400}.intro{max-width:540px;color:#706b61;font-size:17px;line-height:1.75}.shelf-title{display:flex;justify-content:space-between;align-items:center;padding-bottom:17px;border-bottom:1px solid #dfd9ce}.shelf-title h2{margin:0;font-family:Georgia,serif;font-size:24px;font-weight:400}.empty{display:flex;align-items:center;gap:25px;padding:44px 0 74px}.book-mark{position:relative;width:65px;height:86px;flex:0 0 auto;display:grid;place-items:center;background:#dcd3c4;border-left:6px solid #b6a58d;box-shadow:3px 5px 10px #28262118}.book-mark span{font-family:Georgia,serif;font-size:26px;color:#71604a}.empty h3{margin:0 0 8px;font-family:Georgia,serif;font-size:24px;font-weight:400}.empty p{max-width:455px;margin:0;color:#756f64;line-height:1.7}footer{display:flex;justify-content:space-between;padding:21px 0 30px;border-top:1px solid #dfd9ce;color:#81796d;font-size:12px}footer a{font-weight:700;letter-spacing:.12em}@media(max-width:560px){.shelf-title{align-items:flex-start;gap:12px;flex-direction:column}.empty{align-items:flex-start}}
</style>
<style>
  .brand { display: flex; align-items: center; gap: 10px; }
  .brand img { width: 38px; height: 38px; padding: 3px; object-fit: contain; border-radius: 50%; background: #fff; }
  .book-cover-image { width: 140px; min-height: 200px; aspect-ratio: 7 / 10; object-fit: cover; box-shadow: 3px 5px 10px #28262118; }
  .books { display: grid; gap: 34px; padding: 38px 0 72px; }
  .book { display: grid; grid-template-columns: 140px 1fr; gap: 28px; align-items: center; }
  .book h3 { margin: 8px 0; font: 400 26px Georgia, serif; }
  .book > div:last-child > p:not(.genre) { color: #756f64; line-height: 1.7; }
  .book > div:last-child > a { font-size: 13px; }
  @media(max-width:520px) { .book { grid-template-columns: 100px 1fr; gap: 18px; }.book-cover-image { width: 100px; min-height: 143px; } }
</style>
